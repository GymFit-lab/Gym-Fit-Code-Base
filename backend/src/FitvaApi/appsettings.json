{
  "ConnectionStrings": {
    "Fitva": ""
  },
  "Jwt": {
    "Issuer": "fitva-api",
    "Audience": "fitva-clients",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "RateLimits": {
    "LoginPerMinute": 5,
    "RequestsPerMinute": 300
  },
  "Serilog": {
    "FilePath": "logs/fitva-.log",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
