[Unit]
Description=FITVA .NET API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=fitva
Group=fitva
WorkingDirectory=/opt/fitva/api/current
ExecStart=/usr/bin/dotnet /opt/fitva/api/current/FitvaApi.dll
EnvironmentFile=/etc/fitva/api.env
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=fitva-api
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
