# Public URL of the deployed site (used for metadata, sitemap, robots and JSON-LD).
NEXT_PUBLIC_SITE_URL=https://gymfit.example.com

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — used by Prisma and Better Auth.
# e.g. a local Postgres, Neon, Supabase or Prisma Postgres connection string.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymfit

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# BETTER_AUTH_SECRET: random string, at least 32 chars — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BETTER_AUTH_URL: the app's base URL (no trailing slash).
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google sign-in — create an OAuth client (type "Web application") in Google Cloud Console.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Leave empty to hide the "Continue with Google" button.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# TEMPORARY switches while the backend is being built
# AUTH_MODE: "demo" (default) = static login Admin / 1234, no database.
#            "fitva"          = gym staff login + live dashboard/gym data from fitva_db
#                               (needs FITVA_DATABASE_URL; apply database/run_all.sql first).
#            "better-auth"    = real accounts (needs DATABASE_URL + BETTER_AUTH_*).
# DASHBOARD_DATA_SOURCE: "mock" (default) = dummy data from lib/dashboard/mock-data.ts.
#                        "api"            = GET {API_BASE_URL}/dashboard.
# ---------------------------------------------------------------------------
AUTH_MODE=demo
DASHBOARD_DATA_SOURCE=mock
API_BASE_URL=

# ---------------------------------------------------------------------------
# FITVA database (used only when AUTH_MODE=fitva) — see database/DB_CONTRACT.md.
# FITVA_SESSION_SECRET signs the staff session cookie (falls back to BETTER_AUTH_SECRET).
# ---------------------------------------------------------------------------
FITVA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitva_db
FITVA_SESSION_SECRET=
